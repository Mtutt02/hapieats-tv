# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Mux ───────────────────────────────────────────────────────────────────────
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret
# Optional: Mux Data env key for analytics
NEXT_PUBLIC_MUX_DATA_ENV_KEY=your-mux-data-env-key

# ── Stripe ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Platform subscription price ID (from Stripe dashboard)
NEXT_PUBLIC_STRIPE_PLATFORM_PRICE_ID=price_...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Munchor SSO ───────────────────────────────────────────────────────────────
# Munchor runs on its own Supabase project. These let HapiEats verify a Munchor
# sign-in server-side. The ANON key is sufficient and is all that should be used
# here — never put Munchor's service-role key in this app.
# Leave unset to disable "Continue with Munchor" (the button hides itself).
MUNCHOR_SUPABASE_URL=https://your-munchor-ref.supabase.co
MUNCHOR_SUPABASE_ANON_KEY=your-munchor-anon-key
